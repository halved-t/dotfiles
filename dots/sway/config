### SwayFX stuff

corner_radius 7

set $bg_dark      #1f1d2e
set $bg_selection #2f2c40
set $fg_text      #e0def4
set $muted_gray   #908caa
set $accent_blue  #9ccfd8
set $alert_red    #ff5555

# Target Class           Border          Bg              Text            Indicator     Child Border
client.focused           $accent_blue    $bg_selection   $fg_text        $accent_blue  $accent_blue
client.focused_inactive  $bg_selection   $bg_dark        $muted_gray     $bg_selection $bg_selection
client.unfocused         $bg_dark        $bg_dark        $muted_gray     $bg_dark      $bg_dark
client.urgent            $alert_red      $alert_red      $bg_dark        $alert_red    $alert_red


for_window [app_id="qemu" title="QEMU"] floating enable, border normal 3
for_window [class="qemu" title="QEMU"] floating enable, border normal 3
for_window [instance="qemu"] floating enable, border normal 3