{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": { "source": "~/.config/fastfetch/arch.txt", "padding": { "top": 1, "right": 6, "left": 2 } },
  "display": { "separator": " → "},
  "modules": [
    {
      "type": "title",
      "keyWidth": 12,
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "cyan"
      }
    },

    {
      "type": "custom",
      "format": "╭──────────────────────────────────────╮",
      "outputColor": "magenta"
    },

    {
      "type": "os",
      "key": "󰣇  os",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰇄  host",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "󰒋  kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "󰅐  uptime",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "󰏖  pkgs",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󰆍  shell",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "󱂬  wm",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "󰍛  memory",
      "keyColor": "green",
      "format": "{} / {}"
    },
    {
      "type": "disk",
      "key": "󰋊  disk",
      "keyColor": "yellow",
      "folders": "/",
      "format": "{} / {} ({})"
    },

    {
      "type": "custom",
      "format": "╰──────────────────────────────────────╯",
      "outputColor": "magenta"
    },


    {
    "paddingLeft": 0,
    "type": "colors",
    "symbol": "circle"
    }
  ]
}
